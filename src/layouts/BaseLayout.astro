---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONTACT_EMAIL, SOCIAL_LINKS } from '../data/contact';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  /** Full, literal <title> content — each page composes its own. */
  title: string;
  /** Meta description; article pages should pass their `summary`. */
  description: string;
  /**
   * Root-relative path to a 1200×630 share image. Defaults to the
   * site-wide card (public/og-image.jpg) below, so every page gets a
   * correct social preview without having to pass this — a page only
   * needs to supply this prop if it wants its *own* image instead (e.g.
   * a future per-article card), not to opt into having one at all.
   */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogImage = '/og-image.jpg', ogType = 'website' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Must live in public/, not src/assets — astro:assets hashes filenames
// on build (a new filename every time the source image changes), and
// this needs one stable absolute URL crawlers can fetch indefinitely,
// not a build-specific one.
const ogImageURL = new URL(ogImage, Astro.site).href;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Bocconi Shipping and Global Trade Student Association',
  alternateName: 'BSGT',
  url: Astro.site?.href,
  logo: new URL('/favicon.svg', Astro.site).href,
  // Ties the website to the same entity's confirmed social profiles —
  // deliberately omitted until now, since publishing sameAs against
  // profiles that hadn't been confirmed as real/current would have been
  // worse than omitting it. Both come from src/data/contact.ts, the same
  // source the homepage contact section and footer use, so this can't
  // drift from what's actually published on the page.
  sameAs: SOCIAL_LINKS.map((link) => link.url),
  contactPoint: {
    '@type': 'ContactPoint',
    email: CONTACT_EMAIL,
    contactType: 'general inquiries',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="BSGT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <!-- British English throughout the site — en_US was wrong from the start. -->
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageURL} />
    <!-- Fixed at the default card's actual size (public/og-image.jpg,
         1200×630) rather than derived from ogImage — fine while every
         page uses that one image. Revisit if/when a page ever passes a
         differently-sized image (e.g. a future per-article card). -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="BSGT — Bocconi Shipping & Global Trade Student Association. Navigating the future of shipping and maritime finance."
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Preload primary (latin) font subsets -->
    <link
      rel="preload"
      href="/fonts/newsreader/newsreader-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans/ibm-plex-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="visually-hidden skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    background: var(--color-navy-deep);
    color: var(--color-paper);
    outline: 3px solid var(--color-gold);
    outline-offset: 2px;
    z-index: 100;
    clip: auto;
  }
</style>
