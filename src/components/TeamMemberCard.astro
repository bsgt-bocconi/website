---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  member: CollectionEntry<'team'>;
}

const { member } = Astro.props;
const { name, role, programme, photo, photoFocus, linkedin } = member.data;

// The photo keeps its own aspect ratio through the pipeline (width and
// height below match the source's) and is cropped to 4:5 in CSS, not at
// build time — Astro's sharp service centre-crops whenever width/height
// disagree with the source, which would throw the framing away.
//
// Framing, in units of the box's own width (box = 1 wide, 1.25 tall):
// a plain cover fit draws the image max(1, 1.25 × aspect) box-widths
// wide; `zoom` scales that up further. With photoFocus set, the image is
// then offset so the face centre lands at FACE_X/FACE_Y in the box —
// clamped so the image always still covers the whole box, never showing
// a gap at an edge. Without it, it's a plain object-fit: cover favouring
// the upper portion (see the CSS), right for a head-and-shoulders shot.
const FACE_X = 0.5;
const FACE_Y = 0.38; // fraction of the box's height, from the top
const BOX_H = 1.25;
const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

const coverW = photo ? Math.max(1, (BOX_H * photo.width) / photo.height) : 1;
const drawnW = coverW * (photoFocus?.zoom ?? 1);
let frameStyle: string | undefined;
if (photo && photoFocus) {
  const drawnH = (drawnW * photo.height) / photo.width;
  const left = clamp(FACE_X - photoFocus.x * drawnW, 1 - drawnW, 0);
  const top = clamp(FACE_Y * BOX_H - photoFocus.y * drawnH, BOX_H - drawnH, 0);
  const pct = (v: number) => `${(v * 100).toFixed(2)}%`;
  frameStyle = [
    'position: absolute',
    'max-width: none', // global.css caps img at 100%
    `width: ${pct(drawnW)}`,
    `height: ${pct(drawnH / BOX_H)}`,
    `left: ${pct(left)}`,
    `top: ${pct(top / BOX_H)}`,
  ].join('; ');
}

// `sizes` reports the width the image is actually drawn at (drawnW box-
// widths), not just the card's width, so the browser picks a srcset
// candidate sharp enough for the crop. Box widths mirror team.astro's
// grid: 4 columns (2.5rem gaps) inside wrap-wide's 75rem minus 3rem
// padding; 2 columns at ≤900px; 1 at ≤560px.
const f = drawnW.toFixed(3);
const sizes = [
  `(max-width: 560px) calc((100vw - 3rem) * ${f})`,
  `(max-width: 900px) calc((100vw - 5.5rem) / 2 * ${f})`,
  `calc((min(100vw, 75rem) - 10.5rem) / 4 * ${f})`,
].join(', ');
const widths = photo
  ? [...[400, 600, 800, 1200].filter((w) => w < photo.width), photo.width]
  : [];

// First + last word's initial — "Niki Xanthopoulou-Sisini" -> "NX",
// "Zeynep Eylül Öksüz" -> "ZÖ" (middle names, if any, are skipped, same
// as how a monogram normally reads). Only used when there's no photo yet.
function initials(fullName: string): string {
  const parts = fullName.trim().split(/\s+/);
  const first = parts[0]?.[0] ?? '';
  const last = parts.length > 1 ? parts[parts.length - 1][0] : '';
  return (first + last).toUpperCase();
}
---

<div class="member">
  {
    photo ? (
      <div class="member-photo">
        <Image
          src={photo}
          alt={`${name}, ${role}`}
          width={photo.width}
          height={photo.height}
          widths={widths}
          sizes={sizes}
          loading="lazy"
          style={frameStyle}
        />
      </div>
    ) : (
      // Deliberate, not broken: a navy panel with the person's own
      // initials, same box a real photo will fill later — not a generic
      // silhouette avatar, which would read as a broken image rather
      // than an intentional placeholder. aria-hidden since the name
      // right below already gives a screen reader everything this
      // placeholder conveys.
      <div class="member-photo member-photo--placeholder" aria-hidden="true">
        <span class="initials">{initials(name)}</span>
      </div>
    )
  }
  <h3>{name}</h3>
  <p class="role">{role}</p>
  {programme && <p class="programme">{programme}</p>}
  {linkedin && (
    <p class="linkedin">
      <a href={linkedin}>LinkedIn</a>
    </p>
  )}
</div>

<style>
  /* 4:5 — the aspect ratio the eventual real headshots will use, so a
     photo arriving later drops straight into this box with no reflow.
     Border + background apply in both states (photo and placeholder):
     the same frame either way, and if a future photo ever fails to
     load, this navy fill is what's left behind instead of a blank gap. */
  .member-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-navy-mid);
    border: 1px solid color-mix(in srgb, var(--color-gold) 50%, transparent);
  }

  .member-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Favour the upper portion so a centre crop doesn't cut through a
       face. Entries with photoFocus override all of this inline with an
       absolutely-positioned crop computed in the frontmatter. */
    object-position: 50% 20%;
  }

  .member-photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .initials {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: 0.03em;
    /* Verified: gold vs navy-mid is ~11.1:1, same figure already
       verified for the division cards' gold text on this background. */
    color: var(--color-gold);
  }

  .member h3 {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .role {
    margin-top: 0.375rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    /* Not ink — near-invisible on the team page's navy-deep ground. */
    color: var(--color-paper);
  }

  .programme {
    margin-top: 0.125rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    /* Not slate — fails AA on navy-deep at body size. */
    color: var(--color-paper);
    opacity: 0.75;
  }

  .linkedin {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }

  .linkedin a {
    /* Not navy-deep — identical to the page background, so the link
       would be invisible. */
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .linkedin a:hover {
    color: var(--color-gold);
  }
</style>
