---
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'team'>;
}

const { member } = Astro.props;
const { name, role, programme, linkedin } = member.data;
---

<div class="member">
  <h3>{name}</h3>
  <p class="role">{role}</p>
  {programme && <p class="programme">{programme}</p>}
  {linkedin && (
    <p class="linkedin">
      <a href={linkedin}>LinkedIn</a>
    </p>
  )}
</div>

<style>
  .member h3 {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .role {
    margin-top: 0.375rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    /* Not ink — near-invisible on the team page's navy-deep ground. */
    color: var(--color-paper);
  }

  .programme {
    margin-top: 0.125rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    /* Not slate — fails AA on navy-deep at body size. */
    color: var(--color-paper);
    opacity: 0.75;
  }

  .linkedin {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }

  .linkedin a {
    /* Not navy-deep — identical to the page background, so the link
       would be invisible. */
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .linkedin a:hover {
    color: var(--color-gold);
  }
</style>
