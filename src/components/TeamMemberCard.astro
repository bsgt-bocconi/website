---
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'team'>;
}

const { member } = Astro.props;
const { name, role, programme, linkedin } = member.data;
---

<div class="member">
  <h3>{name}</h3>
  <p class="role">{role}</p>
  {programme && <p class="programme">{programme}</p>}
  {linkedin && (
    <p class="linkedin">
      <a href={linkedin}>LinkedIn</a>
    </p>
  )}
</div>

<style>
  .member h3 {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .role {
    margin-top: 0.375rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .programme {
    margin-top: 0.125rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-slate);
  }

  .linkedin {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }

  .linkedin a {
    color: var(--color-navy-deep);
  }
</style>
