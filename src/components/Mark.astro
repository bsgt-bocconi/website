---
/**
 * Two drawings of the same mark, both currentColor:
 * - "fine": brand/bsgt-mark.svg's geometry, drawn for large sizes —
 *   hairlines vanish below ~48px.
 * - "bold": favicon.svg's geometry (background rect and fixed fill
 *   stripped out), the heavier redraw already made for small sizes.
 *   Use this anywhere the mark renders under ~48px, e.g. header/footer.
 */
interface Props {
  size?: number;
  weight?: 'fine' | 'bold';
  class?: string;
}

const { size = 28, weight = 'fine', class: className } = Astro.props;

const viewBox = weight === 'bold' ? '0 0 64 64' : '0 0 120 120';

const paths =
  weight === 'bold'
    ? [
        'M32 10 C34.0 22 34.9 29 34.9 34 C34.9 41 34.0 48 32 55 C30.0 48 29.1 41 29.1 34 C29.1 29 30.0 22 32 10 Z',
        'M17 22.5 C23.5 26.4 28 27.3 32 27.4 C36 27.3 40.5 26.4 47 22.5 C40.5 29.2 36 30.5 32 30.6 C28 30.5 23.5 29.2 17 22.5 Z',
        'M14 31.0 C22.5 37.6 27.4 38.9 32 39.0 C36.6 38.9 41.5 37.6 50 31.0 C41.5 40.4 36.6 42.0 32 42.1 C27.4 42.0 22.5 40.4 14 31.0 Z',
      ]
    : [
        'M60 13 C60.7 34 61.1 48 61.1 58 C61.1 74 60.7 92 60 107 C59.3 92 58.9 74 58.9 58 C58.9 48 59.3 34 60 13 Z',
        'M37 41.8 C47 45.6 53.5 46.4 60 46.5 C66.5 46.4 73 45.6 83 41.8 C73 46.9 66.5 47.7 60 47.8 C53.5 47.7 47 46.9 37 41.8 Z',
        'M31 55.0 C44.5 62.2 52.5 63.3 60 63.4 C67.5 63.3 75.5 62.2 89 55.0 C75.5 63.9 67.5 65.0 60 65.1 C52.5 65.0 44.5 63.9 31 55.0 Z',
      ];
---

<svg viewBox={viewBox} width={size} height={size} role="img" aria-label="BSGT mark" class={className}>
  <g fill="currentColor">
    {paths.map((d) => <path d={d}></path>)}
  </g>
</svg>
