---
// Hand-drawn, inline SVG glyphs — no icon library, no CDN, nothing
// fetched at runtime, per the site's no-third-party-embeds constraint.
// Simplified geometric renditions (basic shapes: rect/circle/line/path),
// not a reproduction of either platform's actual logo artwork.
//
// Always aria-hidden + focusable="false": this icon never carries its
// own accessible name. Callers are responsible for one — either visible
// text next to it (the homepage contact section) or an aria-label on
// the enclosing link (the footer, which is icon-only). An icon with no
// text of its own is invisible to a screen reader either way; the
// accessible name has to come from somewhere outside this component.
interface Props {
  name: 'instagram' | 'linkedin';
}

const { name } = Astro.props;
---

{
  name === 'instagram' && (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === 'linkedin' && (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <line x1="7.5" y1="10" x2="7.5" y2="17" stroke-linecap="round" />
      <circle cx="7.5" cy="6.7" r="0.9" fill="currentColor" stroke="none" />
      <path
        d="M11 17v-4.2c0-1.7 1.1-2.8 2.6-2.8 1.5 0 2.4 1 2.4 2.8V17"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
