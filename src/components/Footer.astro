---
import Mark from './Mark.astro';
import SocialIcon from './SocialIcon.astro';
import { CONTACT_EMAIL, SOCIAL_LINKS } from '../data/contact';

const year = new Date().getFullYear();

const nav = [
  { href: '/', label: 'About' },
  { href: '/team', label: 'Team' },
  { href: '/articles', label: 'Articles' },
  { href: '/events', label: 'Events' },
  { href: '/privacy', label: 'Privacy' },
];
---

<footer class="site-footer on-dark">
  <div class="wrap top">
    <div class="about">
      <a href="/" class="brand" aria-label="BSGT — home">
        <span class="mark"><Mark size={22} weight="bold" /></span>
        <span class="wordmark">BSGT</span>
      </a>
      <p>Bocconi Shipping &amp; Global Trade Student Association</p>
    </div>
    <div class="footer-nav-group">
      <nav aria-label="Footer">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="footer-contact">
        <a class="footer-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <ul class="social-icons" aria-label="BSGT on social media">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.name}
                >
                  <SocialIcon name={link.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
  <div class="wrap">
    <p class="legal">© {year} BSGT, Università Bocconi student association.</p>
  </div>
</footer>

<style>
  /* No margin-top here on purpose — see CLAUDE.md's "Contact & social"
     section for the diagnosis. A margin sits OUTSIDE this element's own
     background, so it exposed whatever's behind it: body's default
     `paper` background (global.css), invisible on light pages where it
     happened to match, but a jarring light strip on every navy-deep page
     where a dark section sat directly above the footer. The fix isn't
     replacing the margin with something else — every page's own closing
     wrapper (.article, .team-page, .events-page, .division-page,
     .privacy, the homepage's .contact-section, ...) already carries its
     own `padding-block` ending in 4rem, in that page's own correct
     background colour. The footer's margin was redundant space on top of
     that, in the wrong colour whenever the page was dark. Sitting flush
     against whatever precedes it is the correct default; don't add a
     margin back here to "fix spacing" without checking whether the page
     you're looking at is one of the ones already padding itself. */
  .site-footer {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    padding-block: 2.5rem 1.5rem;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem 3rem;
    padding-bottom: 1.5rem;
  }

  .about {
    max-width: 28rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3125rem;
    text-decoration: none;
    color: var(--color-gold);
  }

  .mark {
    display: inline-flex;
    /* Same optical alignment as Header.astro, scaled down. See its comment. */
    transform: translateY(5px);
  }

  .wordmark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1;
    color: var(--color-paper);
  }

  .about p {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-paper);
    opacity: 0.75;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-paper);
  }

  nav a:hover {
    color: var(--color-gold);
  }

  /* Groups the page-nav list and the social icons together on the right
     side of .top's space-between row, stacked with a little air between
     them rather than crowded onto one line. */
  .footer-nav-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }

  .footer-contact {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* Quiet and small, per spec — the homepage's own contact section
     (.email-link there) is the full-strength version of this link; this
     is just enough for it to appear on every page without competing
     with the social icons next to it. Pulled from src/data/contact.ts,
     never hardcoded — same source the homepage section and the
     Organization JSON-LD's ContactPoint use. */
  .footer-email {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-paper);
    opacity: 0.75;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .footer-email:hover {
    color: var(--color-gold);
    opacity: 1;
  }

  .social-icons {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-icons a {
    display: flex;
    color: var(--color-paper);
    opacity: 0.75;
  }

  .social-icons a:hover {
    color: var(--color-gold);
    opacity: 1;
  }

  .social-icons :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .legal {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-paper);
    opacity: 0.6;
    border-top: 1px solid rgba(242, 244, 246, 0.15);
    padding-top: 1.25rem;
  }
</style>
