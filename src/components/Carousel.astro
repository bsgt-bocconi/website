---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const slides = (
  await getCollection('slides', ({ data }) => import.meta.env.DEV || data.draft === false)
).sort((a, b) => a.data.order - b.data.order);
---

<section class="carousel-section on-dark" aria-labelledby="carousel-heading">
  <div class="wrap-wide">
    <h2 id="carousel-heading">BSGT in pictures</h2>
    {
      slides.length === 0 ? (
        <p class="empty">Photos are on the way — check back soon.</p>
      ) : (
        <div
          class="carousel"
          tabindex="0"
          role="region"
          aria-label="Photo carousel — use the left and right arrow keys to move between slides"
        >
          <ul class="track">
            {slides.map((entry) =>
              entry.data.image ? (
                <li class="slide">
                  <Image src={entry.data.image} alt={entry.data.caption} loading="lazy" />
                </li>
              ) : (
                <li class="slide placeholder-slide">
                  <p>{entry.data.caption}</p>
                </li>
              ),
            )}
          </ul>
        </div>
      )
    }
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('.carousel');

  carousel?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
    event.preventDefault();
    const slide = carousel.querySelector<HTMLElement>('.slide');
    const step = slide?.getBoundingClientRect().width ?? carousel.clientWidth;
    carousel.scrollBy({ left: event.key === 'ArrowRight' ? step : -step, behavior: 'smooth' });
  });
</script>

<style>
  .carousel-section {
    /* Explicit dark background/text — this component is used standalone
       on the homepage (a plain sibling section, not inside any wrapper
       that supplies a shared ground any more) and inside
       /divisions/[slug]'s .division-page (which already sets the same
       navy-deep/paper pair on itself, so this is redundant but harmless
       there). Self-contained on purpose, so it doesn't depend on
       whatever happens to wrap it. */
    background: var(--color-navy-deep);
    color: var(--color-paper);
    padding-block: 3.5rem;
  }

  .carousel-section h2 {
    max-width: var(--measure);
    margin-bottom: 1.5rem;
  }

  .empty {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    /* Not slate — this section sits on navy-deep (via the homepage's
       .scroll-vessel-area), and slate-on-navy-deep fails AA (~3.6:1) at
       body size. Paper at reduced opacity is the site's dark-ground
       convention for secondary/empty-state text instead. */
    color: var(--color-paper);
    opacity: 0.75;
  }

  .carousel {
    display: block;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  .carousel:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: -3px;
  }

  .track {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .slide {
    flex: 0 0 min(28rem, 85vw);
    aspect-ratio: 3 / 2;
    scroll-snap-align: start;
    overflow: hidden;
    border-radius: 2px;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: var(--color-navy-mid);
    border: 1px dashed color-mix(in srgb, var(--color-paper) 35%, transparent);
  }

  .placeholder-slide p {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-paper);
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel {
      scroll-behavior: auto;
    }
  }
</style>
