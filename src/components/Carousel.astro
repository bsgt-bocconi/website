---
import { Image } from 'astro:assets';
import vessel from '../../brand/vessel.jpg';

const placeholders = [
  'Placeholder — dock and terminal operations photography coming soon.',
  'Placeholder — BSGT events and workshops photography coming soon.',
  'Placeholder — industry guest speakers photography coming soon.',
];
---

<section class="carousel-section" aria-labelledby="carousel-heading">
  <div class="wrap">
    <h2 id="carousel-heading">BSGT in pictures</h2>
    <div
      class="carousel"
      tabindex="0"
      role="region"
      aria-label="Photo carousel — use the left and right arrow keys to move between slides"
    >
      <ul class="track">
        <li class="slide">
          <Image src={vessel} alt="A container vessel at sea" width={1080} height={705} loading="lazy" />
        </li>
        {
          placeholders.map((caption) => (
            <li class="slide placeholder-slide">
              <p>{caption}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('.carousel');

  carousel?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
    event.preventDefault();
    const slide = carousel.querySelector<HTMLElement>('.slide');
    const step = slide?.getBoundingClientRect().width ?? carousel.clientWidth;
    carousel.scrollBy({ left: event.key === 'ArrowRight' ? step : -step, behavior: 'smooth' });
  });
</script>

<style>
  .carousel-section {
    background: var(--color-paper);
    padding-block: 3.5rem;
  }

  .carousel-section h2 {
    max-width: var(--measure);
    margin-bottom: 1.5rem;
  }

  .carousel {
    display: block;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  .carousel:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: -3px;
  }

  .track {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .slide {
    flex: 0 0 min(28rem, 85vw);
    aspect-ratio: 3 / 2;
    scroll-snap-align: start;
    overflow: hidden;
    border-radius: 2px;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: var(--color-navy-mid);
    border: 1px dashed color-mix(in srgb, var(--color-paper) 35%, transparent);
  }

  .placeholder-slide p {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-paper);
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel {
      scroll-behavior: auto;
    }
  }
</style>
