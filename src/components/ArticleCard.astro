---
import type { CollectionEntry } from 'astro:content';
import { formatAuthors, formatDate } from '../lib/format';

interface Props {
  entry: CollectionEntry<'articles'>;
  headingLevel?: 'h2' | 'h3';
  /** "lead" is full editorial weight, for the homepage's leading articles. */
  size?: 'default' | 'lead';
}

const { entry, headingLevel = 'h2', size = 'default' } = Astro.props;
const Heading = headingLevel;
const href = `/articles/${entry.data.slug}`;
---

<article class={`card ${size === 'lead' ? 'lead' : ''}`}>
  <Heading class="title"><a href={href}>{entry.data.title}</a></Heading>
  <p class="meta">
    <span class="byline">{formatAuthors(entry.data.author)}</span>
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
  </p>
  <p class="standfirst">{entry.data.summary}</p>
</article>

<style>
  .card {
    max-width: var(--measure);
  }

  .title {
    font-family: var(--font-serif);
    /* Stepped down from the page h1 (--text-3xl) so entry titles read as
       list items, not competing headlines. */
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .lead .title {
    /* Full editorial weight, for the homepage's leading articles. */
    font-size: var(--text-2xl);
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-slate);
  }

  .standfirst {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }
</style>
