---
import { slugifyTag } from '../lib/format';

interface Props {
  tags: string[];
  activeTag?: string;
}

const { tags, activeTag } = Astro.props;
---

<ul class="tag-list">
  {
    tags.map((tag) => (
      <li>
        <a href={`/articles/tag/${slugifyTag(tag)}`} aria-current={tag === activeTag ? 'page' : undefined}>
          {tag}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list a {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-slate);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-slate);
    text-decoration: none;
  }

  .tag-list a:hover {
    border-color: var(--color-navy-deep);
    color: var(--color-navy-deep);
  }

  .tag-list a[aria-current='page'] {
    border-color: var(--color-navy-deep);
    background: var(--color-navy-deep);
    color: var(--color-paper);
  }
</style>
