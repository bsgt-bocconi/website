---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EventItem from '../components/EventItem.astro';

const articles = (
  await getCollection('articles', ({ data }) => import.meta.env.DEV || data.draft === false)
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const todayStart = new Date();
todayStart.setHours(0, 0, 0, 0);

const nextEvent = (
  await getCollection('events', ({ data }) => import.meta.env.DEV || data.draft === false)
)
  .filter((e) => e.data.date.valueOf() >= todayStart.valueOf())
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())[0];
---

<BaseLayout
  title="BSGT — Bocconi Shipping and Global Trade Student Association"
  description="BSGT is Bocconi University's student association for shipping, maritime economics, and global trade — publishing student research, hosting industry guest lectures and workshops, and connecting Bocconi's next generation of trade professionals."
>
  <div class="wrap home">
    <h1>Bocconi Shipping and Global Trade</h1>

    {
      articles.length === 0 ? (
        <p class="empty">Our first articles are on the way — check back soon.</p>
      ) : (
        <section class="latest">
          <ul class="article-list">
            {articles.map((entry) => (
              <li>
                <ArticleCard entry={entry} headingLevel="h2" size="lead" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      nextEvent && (
        <section class="next-event">
          <h2>Next event</h2>
          <EventItem entry={nextEvent} />
        </section>
      )
    }

    <p class="blurb">
      BSGT is a recognised student association at Università Bocconi focused on shipping,
      maritime economics, and global trade.
      <a href="/about">More about BSGT</a>
    </p>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: 3rem 4rem;
  }

  .home > h1 {
    /*
     * Real page h1, but styled modestly: the articles below are the
     * primary content and should read as the most prominent thing on
     * the page, not a masthead line above them.
     */
    max-width: var(--measure);
    margin-bottom: 2.5rem;
    font-size: var(--text-xl);
    color: var(--color-slate);
  }

  .article-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-list li + li {
    padding-top: 3rem;
    border-top: 1px solid color-mix(in srgb, var(--color-slate) 25%, transparent);
  }

  .empty {
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-slate);
  }

  .next-event {
    max-width: var(--measure);
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 2px solid var(--color-gold);
  }

  .next-event h2 {
    font-size: var(--text-lg);
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .next-event :global(.event) {
    margin-top: 1rem;
  }

  .blurb {
    max-width: 40rem;
    margin-top: 3.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-ink);
  }

  .blurb a {
    display: inline-block;
    margin-left: 0.375rem;
    color: var(--color-navy-deep);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
