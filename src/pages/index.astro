---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
import Carousel from '../components/Carousel.astro';
import VesselSilhouette from '../components/VesselSilhouette.astro';
---

<BaseLayout
  title="BSGT — Bocconi Shipping and Global Trade Student Association"
  description="BSGT is Bocconi University's student association exploring shipping through a financial lens — vessel finance, chartering, capital markets, and sustainable finance — connecting students with the maritime industry through guest speakers, workshops, and events."
>
  <Fragment slot="head">
    <script is:inline>
      // Runs before <body> paints, so a repeat-this-session visitor never
      // sees the intro overlay flash before it's hidden.
      (function () {
        try {
          if (sessionStorage.getItem('bsgt-intro-seen')) {
            document.documentElement.classList.add('intro-seen');
          }
        } catch (err) {
          /* sessionStorage unavailable (e.g. private mode) — fine, intro just plays again */
        }
      })();
    </script>
  </Fragment>

  <div id="intro-overlay" aria-hidden="true">
    <div class="intro-mark">
      <Mark weight="fine" size={120} />
    </div>
  </div>

  <section class="hero on-dark">
    <div class="hero-mark-wrap" aria-hidden="true">
      <Mark weight="fine" size={800} class="hero-mark" />
    </div>
    <div class="hero-content wrap">
      <h1 class="slogan">Navigating the future of shipping &amp; maritime finance</h1>
      <p class="org-name">Bocconi Shipping &amp; Global Trade Student Association</p>
      <p class="founding">
        Founded by a group of 11 driven students and supported by an international
        professional network, July 2026
      </p>
      <p class="mission">
        Bridging the gap between the Bocconi student community and the shipping finance
        industry.
      </p>
    </div>
  </section>

  <div class="scroll-vessel-area on-dark">
    <div class="scroll-vessel-position" aria-hidden="true">
      <div class="scroll-vessel">
        <VesselSilhouette />
      </div>
    </div>

    <section class="about-content">
      <div class="wrap">
        <div class="prose">
          <h2>About us</h2>

          <h3>Where shipping meets finance.</h3>
          <p>
            We are standing at the threshold of major change — and where there is change, there
            is opportunity. Shipping, at the heart of global trade, is no exception.
            Geopolitical tensions, climate transition, new technologies and regulation are
            reshaping the industry and, with it, the way maritime assets are financed, valued
            and invested in.
          </p>

          <h3>BSGT explores shipping through a financial lens.</h3>
          <p>
            We look at the markets and decisions behind the vessels: shipping finance, vessel
            valuation, lending, capital markets, S&amp;P and M&amp;A, asset management,
            chartering, risk and sustainable finance.
          </p>

          <h3>From Bocconi to the maritime industry.</h3>
          <p>
            We want to make shipping finance more accessible to students and bring the industry
            closer to Bocconi. Through guest speakers, workshops, discussions, industry insights
            and collaborative events, we connect students with professionals and real-world
            perspectives.
          </p>

          <h3>Curious about where capital meets the sea?</h3>
          <p>
            Whether you already know shipping or are discovering it for the first time, BSGT is
            a place to learn, connect and explore an industry where finance, economics and
            global trade come together.
          </p>
        </div>
      </div>
    </section>

    <Carousel />
  </div>

  <section class="recruiting on-dark">
    <div class="wrap">
      <p class="statement">Think beyond the vessel.</p>
      <a class="apply-btn" href="https://forms.gle/Ng2gsTbMKWgNvbAM7" target="_blank" rel="noopener">
        Apply
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const overlay = document.getElementById('intro-overlay');
  const alreadySeen = document.documentElement.classList.contains('intro-seen');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (overlay && !alreadySeen && !reduceMotion) {
    let timer: ReturnType<typeof setTimeout>;

    const dismiss = () => {
      overlay.classList.add('is-dismissed');
      try {
        sessionStorage.setItem('bsgt-intro-seen', '1');
      } catch (err) {
        /* private mode or similar — nothing to do, intro just plays again next load */
      }
      clearTimeout(timer);
      overlay.addEventListener('transitionend', () => overlay.remove(), { once: true });
    };

    window.addEventListener('click', dismiss, { once: true });
    window.addEventListener('keydown', dismiss, { once: true });
    window.addEventListener('scroll', dismiss, { once: true, passive: true });
    window.addEventListener('touchstart', dismiss, { once: true, passive: true });

    // Read the same --intro-duration-ms the CSS animation uses, so the
    // auto-dismiss timer and the visual entrance never drift apart.
    const introDurationMs =
      parseFloat(getComputedStyle(overlay).getPropertyValue('--intro-duration-ms')) || 2500;
    timer = setTimeout(dismiss, introDurationMs);
  } else if (overlay) {
    overlay.remove();
  }
</script>

<script>
  // Scroll-linked vessel motion. One rAF loop drives every browser — no
  // animation-timeline: scroll()/view() and no separate fallback path.
  // Why not CSS scroll-driven animation, which looks like the obviously
  // better (native, JS-free) choice: it binds transform directly to raw
  // scroll position, and a mouse wheel scrolls in ~100px steps, so
  // anything bound directly to it moves in visible jumps rather than
  // gliding. The damping below (current easing toward target every
  // frame, not snapping to it) is what produces the glide, and CSS
  // scroll-driven animation has no way to express that — it can only
  // map scroll position straight to animation progress. Tested, and
  // this is why it was rejected — don't "optimise" back to it.

  // Tunable constants — the only three values this should need.
  const DAMPING = 0.35;
  const TRAVEL_VIEWPORTS = 3; // 0→1 travel spans this many viewport-heights of scroll
  const HORIZONTAL_RANGE_VW = 60; // travels from -this to +this, in vw, around centre

  const SETTLE_EPSILON_PX = 0.05; // |target - current| below this snaps instead of easing forever

  const area = document.querySelector<HTMLElement>('.scroll-vessel-area');
  const vessel = document.querySelector<HTMLElement>('.scroll-vessel');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (area && vessel) {
    const rangePx = () => (HORIZONTAL_RANGE_VW / 100) * window.innerWidth;

    if (reduceMotion) {
      // Static at mid-travel. The loop below never starts.
      vessel.style.transform = 'translate3d(0px, 0, 0)';
    } else {
      let sectionTop = 0;
      let current = -rangePx();
      let target = current;
      let rafId: number | null = null;

      const measure = () => {
        sectionTop = area.getBoundingClientRect().top + window.scrollY;
      };

      const frame = () => {
        const travelDistance = TRAVEL_VIEWPORTS * window.innerHeight;
        const progress = Math.min(1, Math.max(0, (window.scrollY - sectionTop) / travelDistance));
        const range = rangePx();
        target = -range + progress * (2 * range);

        current += (target - current) * DAMPING;
        if (Math.abs(target - current) < SETTLE_EPSILON_PX) current = target;

        // No pixel rounding — subpixel positioning is what keeps this
        // smooth. transform only, so this never touches layout.
        vessel.style.transform = `translate3d(${current}px, 0, 0)`;
        rafId = requestAnimationFrame(frame);
      };

      const start = () => {
        if (rafId === null) rafId = requestAnimationFrame(frame);
      };
      const stop = () => {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      };

      measure();
      vessel.style.transform = `translate3d(${current}px, 0, 0)`;
      window.addEventListener('resize', measure, { passive: true });

      // Pauses the rAF loop entirely while the section is off-screen,
      // rather than just skipping visual updates.
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) start();
          else stop();
        },
        { threshold: 0 },
      );
      observer.observe(area);
    }
  }
</script>

<style>
  /* Intro overlay */
  #intro-overlay {
    /*
     * Single source of truth for the intro's length — tune this one
     * value, nothing else. Unitless ms (not a time value) so the JS
     * auto-dismiss timer below can read and parse it directly; CSS
     * turns it into a time via calc(... * 1ms).
     */
    --intro-duration-ms: 2500;

    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-navy-deep);
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  #intro-overlay.is-dismissed {
    opacity: 0;
    pointer-events: none;
  }

  .intro-mark {
    color: var(--color-gold);
    opacity: 0;
    animation: intro-mark-in calc(var(--intro-duration-ms) * 1ms) ease-out forwards;
  }

  @keyframes intro-mark-in {
    0% {
      opacity: 0;
      scale: 0.85;
    }
    35% {
      opacity: 1;
      scale: 1.02;
    }
    70% {
      scale: 1;
    }
    100% {
      opacity: 1;
      scale: 1;
    }
  }

  html.intro-seen #intro-overlay {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-overlay {
      display: none !important;
    }
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background: var(--color-navy-deep);
  }

  .hero-mark-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  @supports (animation-timeline: scroll()) {
    .hero-mark-wrap {
      animation: hero-parallax 1s linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes hero-parallax {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(70px);
    }
  }

  .hero-mark-wrap :global(.hero-mark) {
    position: absolute;
    top: 50%;
    right: -10%;
    translate: 0 -50%;
    width: clamp(480px, 65vw, 1100px);
    height: auto;
    color: var(--color-gold);
    animation: hero-mark-drift 150s linear infinite;
  }

  @keyframes hero-mark-drift {
    0% {
      rotate: 0deg;
      opacity: 0.1;
    }
    50% {
      rotate: 180deg;
      opacity: 0.16;
    }
    100% {
      rotate: 360deg;
      opacity: 0.1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark-wrap {
      animation: none !important;
    }
    .hero-mark-wrap :global(.hero-mark) {
      animation: none !important;
      opacity: 0.1;
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: 6rem;
    max-width: 46rem;
  }

  .slogan,
  .org-name,
  .founding,
  .mission {
    opacity: 0;
  }

  .slogan {
    font-size: var(--text-3xl);
    color: var(--color-paper);
    animation: fade-in-up 0.9s ease-out 0.1s forwards;
  }

  .org-name {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-gold);
    animation: fade-in-up 0.9s ease-out 0.5s forwards;
  }

  .founding,
  .mission {
    margin-top: 1rem;
    max-width: 36rem;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-paper);
    opacity: 0;
  }

  .founding {
    animation: fade-in-up-dim 0.9s ease-out 0.9s forwards;
  }

  .mission {
    animation: fade-in-up-dim 0.9s ease-out 1.1s forwards;
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Same entrance as fade-in-up, but settles at 0.85 opacity — founding/
     mission read as a quieter tier than the slogan and org name. */
  @keyframes fade-in-up-dim {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 0.85;
      transform: translateY(0);
    }
  }

  /* Scroll-linked vessel — wraps About + the carousel so both share one
     navy-deep ground (matching the hero and recruiting block, so the whole
     homepage reads as one continuous dark surface) with the vessel visible
     behind them. Intentionally does NOT wrap the recruiting section: that's
     a separate closing block, and the brief said one moving element at a
     time (the hero mark) plus this — not three things drifting at once.
     --focus-ring switches to gold here via .on-dark; color is set
     explicitly to paper since .on-dark only handles the focus ring. */
  .scroll-vessel-area {
    position: relative;
    background: var(--color-navy-deep);
    color: var(--color-paper);
    /* Clips the vessel's horizontal travel — this, not the travel range
       itself, is what guarantees no horizontal scrollbar at any width. */
    overflow: hidden;
  }

  .scroll-vessel-position {
    position: absolute;
    /* ~33% down the viewport, 52% of viewport width clamped so it stays
       sensible from phone to ultrawide — tuned in a 680px-wide prototype,
       expressed here as the same proportions rather than fixed pixels. */
    top: 33%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(260px, 52vw, 720px);
    pointer-events: none;
    z-index: 0;
  }

  .scroll-vessel {
    color: var(--color-gold);
    /* Horizontal-only transform, written every frame by the script below.
       will-change hints the browser to promote this to its own compositor
       layer up front, rather than on the first animated frame. */
    will-change: transform;
  }

  .scroll-vessel :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    /*
     * Opacity verified against AA, not assumed — and re-verified here
     * specifically because the artwork changed (a much more detailed
     * vessel replaced the simple silhouette this was first tuned for),
     * even though the opacity value itself (0.2) didn't. The contrast
     * math is a per-pixel colour computation — gold-at-0.2 blended into
     * navy-deep is the same blended colour regardless of how much of the
     * page that colour covers — so a bigger, busier ship doesn't change
     * the ratio, only how much body text has a chance to sit over it.
     * Re-checked both text tiers used on this ground against the
     * worst case (text directly over the densest part of the
     * silhouette):
     *   - full-opacity paper body text:        ~11.7:1
     *   - 0.75-opacity paper (secondary/meta):   ~7.4:1
     * Both still clear the 4.5:1 AA floor with wide margin. Don't push
     * past ~0.25 without re-checking the dimmed-text case specifically —
     * it's the tighter of the two.
     */
    opacity: 0.2;
  }

  /* About content — heading/paragraph sizing comes from .prose (global.css).
     Text colour itself is inherited from .scroll-vessel-area's `color:
     paper` — .prose sets no colour of its own for headings/paragraphs, so
     nothing extra is needed for those. .prose *does* set its own colour
     for links and blockquotes (navy-deep and slate respectively, both
     meant for the paper ground articles use), which would be invisible or
     fail AA here, so those two get scoped overrides — defensive, since the
     current About copy has neither, but a future edit might. */
  .about-content {
    position: relative;
    z-index: 1;
    padding-block: 4rem;
  }

  .about-content .prose a {
    color: var(--color-gold);
  }

  .about-content .prose blockquote {
    color: var(--color-paper);
    opacity: 0.85;
  }

  /* .prose h2 normally carries margin-top: 2em, but "About us" is the
     section's first element and shouldn't have a gap above it. */
  .about-content .prose > h2:first-child {
    margin-top: 0;
  }

  /* Recruiting */
  .recruiting {
    background: var(--color-navy-deep);
    padding-block: 6rem;
    text-align: left;
  }

  .statement {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    line-height: var(--leading-tight);
    /* Deliberately quiet — sized as WCAG "large text" so the ~3.3:1 blend
       against navy-deep still clears the AA large-text contrast floor. */
    color: color-mix(in srgb, var(--color-paper) 38%, var(--color-navy-deep));
    max-width: 30ch;
  }

  .apply-btn {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.875rem 2rem;
    background: var(--color-gold);
    color: var(--color-navy-deep);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    border-radius: 2px;
  }

  .apply-btn:hover {
    background: color-mix(in srgb, var(--color-gold) 85%, white);
  }
</style>
