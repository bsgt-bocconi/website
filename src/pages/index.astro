---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
import Carousel from '../components/Carousel.astro';
---

<BaseLayout
  title="BSGT — Bocconi Shipping and Global Trade Student Association"
  description="BSGT is Bocconi University's student association exploring shipping through a financial lens — vessel finance, chartering, capital markets, and sustainable finance — connecting students with the maritime industry through guest speakers, workshops, and events."
>
  <Fragment slot="head">
    <script is:inline>
      // Runs before <body> paints, so a repeat-this-session visitor never
      // sees the intro overlay flash before it's hidden.
      (function () {
        try {
          if (sessionStorage.getItem('bsgt-intro-seen')) {
            document.documentElement.classList.add('intro-seen');
          }
        } catch (err) {
          /* sessionStorage unavailable (e.g. private mode) — fine, intro just plays again */
        }
      })();
    </script>
  </Fragment>

  <div id="intro-overlay" aria-hidden="true">
    <div class="intro-mark">
      <Mark weight="fine" size={120} />
    </div>
  </div>

  <section class="hero on-dark">
    <div class="hero-mark-wrap" aria-hidden="true">
      <Mark weight="fine" size={800} class="hero-mark" />
    </div>
    <div class="hero-content wrap">
      <h1 class="slogan">Navigating the future of shipping &amp; maritime finance</h1>
      <p class="org-name">Bocconi Shipping &amp; Global Trade Student Association</p>
      <p class="founding">
        Founded by a group of 11 driven students and supported by an international
        professional network, July 2026
      </p>
      <p class="mission">
        Bridging the gap between the Bocconi student community and the shipping finance
        industry.
      </p>
    </div>
  </section>

  <div class="scroll-vessel-area">
    <div class="scroll-vessel-position" aria-hidden="true">
      <div class="scroll-vessel">
        <img src="/vessel-silhouette.svg" alt="" />
      </div>
    </div>

    <section class="about-content">
      <div class="wrap">
        <div class="prose">
          <h2>About us</h2>

          <h3>Where shipping meets finance.</h3>
          <p>
            We are standing at the threshold of major change — and where there is change, there
            is opportunity. Shipping, at the heart of global trade, is no exception.
            Geopolitical tensions, climate transition, new technologies and regulation are
            reshaping the industry and, with it, the way maritime assets are financed, valued
            and invested in.
          </p>

          <h3>BSGT explores shipping through a financial lens.</h3>
          <p>
            We look at the markets and decisions behind the vessels: shipping finance, vessel
            valuation, lending, capital markets, S&amp;P and M&amp;A, asset management,
            chartering, risk and sustainable finance.
          </p>

          <h3>From Bocconi to the maritime industry.</h3>
          <p>
            We want to make shipping finance more accessible to students and bring the industry
            closer to Bocconi. Through guest speakers, workshops, discussions, industry insights
            and collaborative events, we connect students with professionals and real-world
            perspectives.
          </p>

          <h3>Curious about where capital meets the sea?</h3>
          <p>
            Whether you already know shipping or are discovering it for the first time, BSGT is
            a place to learn, connect and explore an industry where finance, economics and
            global trade come together.
          </p>
        </div>
      </div>
    </section>

    <Carousel />
  </div>

  <section class="recruiting on-dark">
    <div class="wrap">
      <p class="statement">Think beyond the vessel.</p>
      <a class="apply-btn" href="https://forms.gle/Ng2gsTbMKWgNvbAM7" target="_blank" rel="noopener">
        Apply
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const overlay = document.getElementById('intro-overlay');
  const alreadySeen = document.documentElement.classList.contains('intro-seen');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (overlay && !alreadySeen && !reduceMotion) {
    let timer: ReturnType<typeof setTimeout>;

    const dismiss = () => {
      overlay.classList.add('is-dismissed');
      try {
        sessionStorage.setItem('bsgt-intro-seen', '1');
      } catch (err) {
        /* private mode or similar — nothing to do, intro just plays again next load */
      }
      clearTimeout(timer);
      overlay.addEventListener('transitionend', () => overlay.remove(), { once: true });
    };

    window.addEventListener('click', dismiss, { once: true });
    window.addEventListener('keydown', dismiss, { once: true });
    window.addEventListener('scroll', dismiss, { once: true, passive: true });
    window.addEventListener('touchstart', dismiss, { once: true, passive: true });

    // Read the same --intro-duration-ms the CSS animation uses, so the
    // auto-dismiss timer and the visual entrance never drift apart.
    const introDurationMs =
      parseFloat(getComputedStyle(overlay).getPropertyValue('--intro-duration-ms')) || 2500;
    timer = setTimeout(dismiss, introDurationMs);
  } else if (overlay) {
    overlay.remove();
  }
</script>

<script>
  // Fallback for browsers without CSS scroll-driven animations
  // (animation-timeline: view()) — feature-detected, not UA-sniffed. The
  // @supports block in this page's <style> handles the modern path; this
  // only runs when that path is unavailable.
  const supportsViewTimeline = CSS.supports('animation-timeline: view()');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!supportsViewTimeline && !prefersReducedMotion) {
    const vessel = document.querySelector<HTMLElement>('.scroll-vessel');

    if (vessel) {
      let ticking = false;

      // Tracks .scroll-vessel's own box, the same element the CSS
      // view()-timeline animation targets — not the much taller
      // .scroll-vessel-area it sits inside — so the two paths pace the
      // same way. Mirrors the "cover" range a view() timeline uses: 0%
      // when the element's top edge reaches the viewport's bottom edge
      // (just entering), 100% when its bottom edge reaches the
      // viewport's top edge (just finished leaving). Reading
      // getBoundingClientRect() here is safe even though this same
      // element is what gets the transform written to it below — the
      // transform is horizontal-only (translateX), so it never affects
      // the vertical top/height this calculation reads.
      const update = () => {
        const rect = vessel.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const total = rect.height + viewportHeight;
        const traveled = viewportHeight - rect.top;
        const progress = Math.min(1, Math.max(0, traveled / total));
        const offsetVw = -15 + progress * 30;
        vessel.style.transform = `translateX(${offsetVw}vw)`;
        ticking = false;
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>

<style>
  /* Intro overlay */
  #intro-overlay {
    /*
     * Single source of truth for the intro's length — tune this one
     * value, nothing else. Unitless ms (not a time value) so the JS
     * auto-dismiss timer below can read and parse it directly; CSS
     * turns it into a time via calc(... * 1ms).
     */
    --intro-duration-ms: 2500;

    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-navy-deep);
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  #intro-overlay.is-dismissed {
    opacity: 0;
    pointer-events: none;
  }

  .intro-mark {
    color: var(--color-gold);
    opacity: 0;
    animation: intro-mark-in calc(var(--intro-duration-ms) * 1ms) ease-out forwards;
  }

  @keyframes intro-mark-in {
    0% {
      opacity: 0;
      scale: 0.85;
    }
    35% {
      opacity: 1;
      scale: 1.02;
    }
    70% {
      scale: 1;
    }
    100% {
      opacity: 1;
      scale: 1;
    }
  }

  html.intro-seen #intro-overlay {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-overlay {
      display: none !important;
    }
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background: var(--color-navy-deep);
  }

  .hero-mark-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  @supports (animation-timeline: scroll()) {
    .hero-mark-wrap {
      animation: hero-parallax 1s linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes hero-parallax {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(70px);
    }
  }

  .hero-mark-wrap :global(.hero-mark) {
    position: absolute;
    top: 50%;
    right: -10%;
    translate: 0 -50%;
    width: clamp(480px, 65vw, 1100px);
    height: auto;
    color: var(--color-gold);
    animation: hero-mark-drift 150s linear infinite;
  }

  @keyframes hero-mark-drift {
    0% {
      rotate: 0deg;
      opacity: 0.1;
    }
    50% {
      rotate: 180deg;
      opacity: 0.16;
    }
    100% {
      rotate: 360deg;
      opacity: 0.1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark-wrap {
      animation: none !important;
    }
    .hero-mark-wrap :global(.hero-mark) {
      animation: none !important;
      opacity: 0.1;
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: 6rem;
    max-width: 46rem;
  }

  .slogan,
  .org-name,
  .founding,
  .mission {
    opacity: 0;
  }

  .slogan {
    font-size: var(--text-3xl);
    color: var(--color-paper);
    animation: fade-in-up 0.9s ease-out 0.1s forwards;
  }

  .org-name {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-gold);
    animation: fade-in-up 0.9s ease-out 0.5s forwards;
  }

  .founding,
  .mission {
    margin-top: 1rem;
    max-width: 36rem;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-paper);
    opacity: 0;
  }

  .founding {
    animation: fade-in-up-dim 0.9s ease-out 0.9s forwards;
  }

  .mission {
    animation: fade-in-up-dim 0.9s ease-out 1.1s forwards;
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Same entrance as fade-in-up, but settles at 0.85 opacity — founding/
     mission read as a quieter tier than the slogan and org name. */
  @keyframes fade-in-up-dim {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 0.85;
      transform: translateY(0);
    }
  }

  /* Scroll-linked vessel — wraps About + the carousel so both share one
     paper background with the vessel visible behind them. Intentionally
     does NOT wrap the recruiting section: that's a separate, dark, closing
     block, and the brief said one moving element at a time (the hero mark)
     plus this — not three things drifting around simultaneously. */
  .scroll-vessel-area {
    position: relative;
    background: var(--color-paper);
    /* Clips the vessel's horizontal travel — this, not the travel range
       itself, is what guarantees no horizontal scrollbar at any width. */
    overflow: hidden;
  }

  .scroll-vessel-position {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(320px, 55vw, 640px);
    pointer-events: none;
    z-index: 0;
  }

  .scroll-vessel img {
    display: block;
    width: 100%;
    height: auto;
    /*
     * Opacity verified against AA, not assumed: blending gold #F5C877 at
     * 0.08 into paper #F2F4F6 shifts relative luminance from 0.9023 to
     * ~0.876. Worst case in this region is slate (#5A6B7A) body text,
     * which is already the tightest pairing on the site (4.99:1 on plain
     * paper) — against the blended colour it computes to ~4.85:1, still
     * clear of the 4.5:1 AA floor for normal text. Ink-coloured text
     * (what this page actually uses) has far more headroom regardless.
     */
    opacity: 0.08;
  }

  @supports (animation-timeline: view()) {
    .scroll-vessel {
      animation: vessel-scroll-x linear both;
      animation-timeline: view();
      animation-range: cover;
    }
  }

  @keyframes vessel-scroll-x {
    from {
      transform: translateX(-15vw);
    }
    to {
      transform: translateX(15vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-vessel {
      animation: none !important;
      transform: none !important;
    }
  }

  /* About content — heading/paragraph sizing comes from .prose (global.css) */
  .about-content {
    position: relative;
    z-index: 1;
    padding-block: 4rem;
  }

  /* .prose h2 normally carries margin-top: 2em, but "About us" is the
     section's first element and shouldn't have a gap above it. */
  .about-content .prose > h2:first-child {
    margin-top: 0;
  }

  /* Recruiting */
  .recruiting {
    background: var(--color-navy-deep);
    padding-block: 6rem;
    text-align: left;
  }

  .statement {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    line-height: var(--leading-tight);
    /* Deliberately quiet — sized as WCAG "large text" so the ~3.3:1 blend
       against navy-deep still clears the AA large-text contrast floor. */
    color: color-mix(in srgb, var(--color-paper) 38%, var(--color-navy-deep));
    max-width: 30ch;
  }

  .apply-btn {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.875rem 2rem;
    background: var(--color-gold);
    color: var(--color-navy-deep);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    border-radius: 2px;
  }

  .apply-btn:hover {
    background: color-mix(in srgb, var(--color-gold) 85%, white);
  }
</style>
