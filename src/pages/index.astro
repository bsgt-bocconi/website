---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
import Carousel from '../components/Carousel.astro';
import VesselSilhouette from '../components/VesselSilhouette.astro';
import ApplyButton from '../components/ApplyButton.astro';
import { divisions } from '../data/divisions';
---

<BaseLayout
  title="BSGT — Bocconi Shipping and Global Trade Student Association"
  description="BSGT is Bocconi University's student association exploring shipping through a financial lens — vessel finance, chartering, capital markets, and sustainable finance — connecting students with the maritime industry through guest speakers, workshops, and events."
>
  <Fragment slot="head">
    <script is:inline>
      // Runs before <body> paints, so a repeat-this-session visitor never
      // sees the intro overlay flash before it's hidden.
      (function () {
        try {
          if (sessionStorage.getItem('bsgt-intro-seen')) {
            document.documentElement.classList.add('intro-seen');
          }
        } catch (err) {
          /* sessionStorage unavailable (e.g. private mode) — fine, intro just plays again */
        }
      })();
    </script>
  </Fragment>

  <div id="intro-overlay" aria-hidden="true">
    <div class="intro-mark">
      <Mark weight="fine" size={120} />
    </div>
  </div>

  <div class="scroll-vessel-area on-dark">
    <div class="scroll-vessel-clip" aria-hidden="true">
      <div class="scroll-vessel-position">
        <div class="scroll-vessel">
          <VesselSilhouette />
        </div>
      </div>
    </div>

    <section class="hero">
      <div class="hero-mark-wrap" aria-hidden="true">
        <Mark weight="fine" size={800} class="hero-mark" />
      </div>
      <div class="hero-content wrap-wide">
        <h1 class="slogan">Navigating the future of shipping &amp; maritime finance</h1>
        <p class="org-name">Bocconi Shipping &amp; Global Trade Student Association</p>
        <p class="founding">
          Founded by a group of 11 driven students and supported by an international
          professional network, July 2026
        </p>
        <p class="mission">
          Bridging the gap between the Bocconi student community and the shipping finance
          industry.
        </p>
      </div>
    </section>

    <section class="about-content">
      <div class="wrap-wide">
        <h2>About us</h2>

        <div class="about-grid">
          <div class="about-pair">
            <h3>Where shipping meets finance.</h3>
            <p>
              We are standing at the threshold of major change — and where there is change,
              there is opportunity. Shipping, at the heart of global trade, is no exception.
              Geopolitical tensions, climate transition, new technologies and regulation are
              reshaping the industry and, with it, the way maritime assets are financed, valued
              and invested in.
            </p>
          </div>

          <div class="about-pair">
            <h3>BSGT explores shipping through a financial lens.</h3>
            <p>
              We look at the markets and decisions behind the vessels: shipping finance, vessel
              valuation, lending, capital markets, S&amp;P and M&amp;A, asset management,
              chartering, risk and sustainable finance.
            </p>
          </div>

          <div class="about-pair">
            <h3>From Bocconi to the maritime industry.</h3>
            <p>
              We want to make shipping finance more accessible to students and bring the
              industry closer to Bocconi. Through guest speakers, workshops, discussions,
              industry insights and collaborative events, we connect students with
              professionals and real-world perspectives.
            </p>
          </div>

          <div class="about-pair">
            <h3>Curious about where capital meets the sea?</h3>
            <p>
              Whether you already know shipping or are discovering it for the first time, BSGT
              is a place to learn, connect and explore an industry where finance, economics and
              global trade come together.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="divisions-section on-dark">
    <div class="wrap-wide">
      <h2 class="divisions-heading">One vision, supported by three divisions</h2>

      <div class="divisions-stack">
        {
          divisions.map((division, i) => (
            <div class="division-card" style={{ '--i': i }}>
              <span class="block-number">{String(i + 1).padStart(2, '0')}</span>
              <h3>{division.name}</h3>
              <p class="tagline">{division.tagline}</p>
              <p class="description">{division.description}</p>
              <a class="visit-link" href={`/divisions/${division.slug}`}>
                Visit division
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Carousel />

  <section class="recruiting on-dark">
    <div class="wrap-wide">
      <p class="statement">Think beyond the vessel.</p>
      <ApplyButton />
    </div>
  </section>
</BaseLayout>

<script>
  const overlay = document.getElementById('intro-overlay');
  const alreadySeen = document.documentElement.classList.contains('intro-seen');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (overlay && !alreadySeen && !reduceMotion) {
    let timer: ReturnType<typeof setTimeout>;

    const dismiss = () => {
      overlay.classList.add('is-dismissed');
      try {
        sessionStorage.setItem('bsgt-intro-seen', '1');
      } catch (err) {
        /* private mode or similar — nothing to do, intro just plays again next load */
      }
      clearTimeout(timer);
      overlay.addEventListener('transitionend', () => overlay.remove(), { once: true });
    };

    window.addEventListener('click', dismiss, { once: true });
    window.addEventListener('keydown', dismiss, { once: true });
    window.addEventListener('scroll', dismiss, { once: true, passive: true });
    window.addEventListener('touchstart', dismiss, { once: true, passive: true });

    // Read the same --intro-duration-ms the CSS animation uses, so the
    // auto-dismiss timer and the visual entrance never drift apart.
    const introDurationMs =
      parseFloat(getComputedStyle(overlay).getPropertyValue('--intro-duration-ms')) || 2500;
    timer = setTimeout(dismiss, introDurationMs);
  } else if (overlay) {
    overlay.remove();
  }
</script>

<script>
  // Scroll-linked vessel motion. One rAF loop drives every browser — no
  // animation-timeline: scroll()/view() and no separate fallback path.
  // Why not CSS scroll-driven animation, which looks like the obviously
  // better (native, JS-free) choice: it binds transform directly to raw
  // scroll position, and a mouse wheel scrolls in ~100px steps, so
  // anything bound directly to it moves in visible jumps rather than
  // gliding. The damping below (current easing toward target every
  // frame, not snapping to it) is what produces the glide, and CSS
  // scroll-driven animation has no way to express that — it can only
  // map scroll position straight to animation progress. Tested, and
  // this is why it was rejected — don't "optimise" back to it.
  import { DAMPING } from '../lib/motion';

  // Not currently used by the active progress formula below (see frame()) —
  // that formula maps the whole passage through the viewport directly, so
  // this doesn't govern it. Kept declared, not deleted, in case a future
  // pass wants a viewport-count-based cap again.
  const TRAVEL_VIEWPORTS = 3;

  const SETTLE_EPSILON_PX = 0.05; // |target - current| below this snaps instead of easing forever

  const area = document.querySelector<HTMLElement>('.scroll-vessel-area');
  const vessel = document.querySelector<HTMLElement>('.scroll-vessel');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (area && vessel) {
    // Full crossing: the ship starts entirely off the left edge and ends
    // entirely off the right. That requires knowing its own rendered
    // width, not just a fixed vw guess — half of (viewport width + ship
    // width) is how far the centred ship has to travel each direction to
    // clear the corresponding edge completely. Recalculated on resize,
    // not every frame — it only changes when the viewport or the ship's
    // own (CSS-driven, responsive) width does.
    let range = 0;
    const measureRange = () => {
      range = (window.innerWidth + vessel.offsetWidth) / 2;
    };

    if (reduceMotion) {
      // Static at mid-travel. The loop below never starts.
      vessel.style.transform = 'translate3d(0px, 0, 0)';
    } else {
      let current = 0;
      let target = 0;
      let rafId: number | null = null;

      const frame = () => {
        // Progress spans the section's whole passage through the
        // viewport, starting the moment it first appears (not once it's
        // fully in frame): 0 when the section's top edge just touches
        // the viewport's bottom edge, 1 when its bottom edge just
        // clears the viewport's top edge. Read fresh every frame —
        // rect.top changes continuously as the page scrolls, and this
        // read doesn't force layout since nothing here writes anything
        // layout-affecting (transform only).
        const rect = area.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const progress = Math.min(
          1,
          Math.max(0, (viewportHeight - rect.top) / (rect.height + viewportHeight)),
        );
        target = -range + progress * (2 * range);

        current += (target - current) * DAMPING;
        if (Math.abs(target - current) < SETTLE_EPSILON_PX) current = target;

        // No pixel rounding — subpixel positioning is what keeps this
        // smooth. transform only, so this never touches layout.
        vessel.style.transform = `translate3d(${current}px, 0, 0)`;
        rafId = requestAnimationFrame(frame);
      };

      const start = () => {
        if (rafId === null) rafId = requestAnimationFrame(frame);
      };
      const stop = () => {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      };

      measureRange();
      current = -range;
      target = current;
      vessel.style.transform = `translate3d(${current}px, 0, 0)`;
      window.addEventListener('resize', measureRange, { passive: true });

      // Pauses the rAF loop entirely while the section is off-screen,
      // rather than just skipping visual updates.
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) start();
          else stop();
        },
        { threshold: 0 },
      );
      observer.observe(area);
    }
  }
</script>

<style>
  /* Intro overlay */
  #intro-overlay {
    /*
     * Single source of truth for the intro's length — tune this one
     * value, nothing else. Unitless ms (not a time value) so the JS
     * auto-dismiss timer below can read and parse it directly; CSS
     * turns it into a time via calc(... * 1ms).
     */
    --intro-duration-ms: 2500;

    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-navy-deep);
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  #intro-overlay.is-dismissed {
    opacity: 0;
    pointer-events: none;
  }

  .intro-mark {
    color: var(--color-gold);
    opacity: 0;
    animation: intro-mark-in calc(var(--intro-duration-ms) * 1ms) ease-out forwards;
  }

  @keyframes intro-mark-in {
    0% {
      opacity: 0;
      scale: 0.85;
    }
    35% {
      opacity: 1;
      scale: 1.02;
    }
    70% {
      scale: 1;
    }
    100% {
      opacity: 1;
      scale: 1;
    }
  }

  html.intro-seen #intro-overlay {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-overlay {
      display: none !important;
    }
  }

  /* Hero. No background of its own on purpose — it now lives inside
     .scroll-vessel-area (see below), and needs to stay transparent so the
     ship shows through behind its own content, the same way it already
     shows through behind .about-content further down. z-index: 1 keeps
     the hero's own box (mark-wrap + content) painting above the ship's
     z-index: 0 clip layer, which is a sibling now, not a descendant.
     overflow: hidden here is unrelated to any of that — it's purely to
     clip .hero-mark-wrap's own drift/rotation to the hero's box, and
     stays safe to use because nothing inside .hero is position: sticky. */
  .hero {
    position: relative;
    z-index: 1;
    overflow: hidden;
    min-height: 100dvh;
    display: flex;
    align-items: center;
  }

  .hero-mark-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  @supports (animation-timeline: scroll()) {
    .hero-mark-wrap {
      animation: hero-parallax 1s linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes hero-parallax {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(70px);
    }
  }

  .hero-mark-wrap :global(.hero-mark) {
    position: absolute;
    top: 50%;
    right: -10%;
    translate: 0 -50%;
    width: clamp(480px, 65vw, 1100px);
    height: auto;
    color: var(--color-gold);
    animation: hero-mark-drift 150s linear infinite;
  }

  @keyframes hero-mark-drift {
    0% {
      rotate: 0deg;
      opacity: 0.1;
    }
    50% {
      rotate: 180deg;
      opacity: 0.16;
    }
    100% {
      rotate: 360deg;
      opacity: 0.1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark-wrap {
      animation: none !important;
    }
    .hero-mark-wrap :global(.hero-mark) {
      animation: none !important;
      opacity: 0.1;
    }
  }

  .hero-content {
    /* No max-width here — this is the wide, page-consistent container
       (.wrap-wide) now. Left-aligned by default (no text-align set), so
       widening it doesn't centre anything; it just moves the right edge
       out. The slogan gets its own cap below so the headline itself
       doesn't stretch edge-to-edge at 1200px; founding/mission already
       had their own 36rem cap independent of this one. */
    position: relative;
    z-index: 1;
    padding-block: 6rem;
  }

  .slogan,
  .org-name,
  .founding,
  .mission {
    opacity: 0;
  }

  .slogan {
    max-width: 42rem;
    font-size: var(--text-3xl);
    color: var(--color-paper);
    animation: fade-in-up 0.9s ease-out 0.1s forwards;
  }

  .org-name {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-gold);
    animation: fade-in-up 0.9s ease-out 0.5s forwards;
  }

  .founding,
  .mission {
    margin-top: 1rem;
    max-width: 36rem;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-paper);
    opacity: 0;
  }

  .founding {
    animation: fade-in-up-dim 0.9s ease-out 0.9s forwards;
  }

  .mission {
    animation: fade-in-up-dim 0.9s ease-out 1.1s forwards;
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Same entrance as fade-in-up, but settles at 0.85 opacity — founding/
     mission read as a quieter tier than the slogan and org name. */
  @keyframes fade-in-up-dim {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 0.85;
      transform: translateY(0);
    }
  }

  /* Scroll-linked vessel — wraps the hero + About only, so the ship's
     travel spans exactly that combined height and visibly stops the
     moment the divisions section begins (the JS below reads this
     element's own getBoundingClientRect(), so the ship's whole crossing
     is scoped by DOM structure here, not by anything in the script).
     Previously this wrapped About + divisions + carousel instead — moved
     deliberately: divisions and the carousel are both below this now,
     each with their own explicit navy-deep background, so the page still
     reads as one continuous dark surface end to end even though the ship
     itself no longer runs the full length of it.
     --focus-ring switches to gold here via .on-dark; color is set
     explicitly to paper since .on-dark only handles the focus ring.

     No overflow property on this element, and there never should be one
     again. Measured, not assumed, the last time this got it wrong: even
     `overflow-x: hidden` alone (leaving overflow-y unset) was enough to
     silently break position: sticky on a descendant, because per the CSS
     Overflow spec an element can't have one axis compute to hidden and
     the other stay visible — the UA forces the unset axis from visible to
     auto, and auto breaks sticky exactly like hidden does. The divisions
     cards are sticky again now (see "Divisions" below), just no longer
     nested inside this element at all — but the rule stands regardless of
     what's nested here today: clip the ship's own horizontal travel on
     its own dedicated layer (.scroll-vessel-clip, below), never on a
     shared ancestor. */
  .scroll-vessel-area {
    position: relative;
    background: var(--color-navy-deep);
    color: var(--color-paper);
  }

  /* Clips the vessel's horizontal travel — the only reason
     .scroll-vessel-area used to carry `overflow: hidden` itself. See the
     comment on .scroll-vessel-area above for why that clip lives here, on
     its own absolutely-positioned, full-bleed layer, instead. inset: 0
     matches it to .scroll-vessel-area's own box exactly (that area has no
     padding), so the clip boundary is unchanged. */
  .scroll-vessel-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .scroll-vessel-position {
    position: absolute;
    /* ~33% down the viewport, 52% of viewport width clamped so it stays
       sensible from phone to ultrawide — tuned in a 680px-wide prototype,
       expressed here as the same proportions rather than fixed pixels. */
    top: 33%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(260px, 52vw, 720px);
  }

  .scroll-vessel {
    color: var(--color-gold);
    /* Horizontal-only transform, written every frame by the script below.
       will-change hints the browser to promote this to its own compositor
       layer up front, rather than on the first animated frame. */
    will-change: transform;
  }

  .scroll-vessel :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    /*
     * Opacity verified against AA, not assumed — and re-verified here
     * specifically because the artwork changed (a much more detailed
     * vessel replaced the simple silhouette this was first tuned for),
     * even though the opacity value itself (0.2) didn't. The contrast
     * math is a per-pixel colour computation — gold-at-0.2 blended into
     * navy-deep is the same blended colour regardless of how much of the
     * page that colour covers — so a bigger, busier ship doesn't change
     * the ratio, only how much body text has a chance to sit over it.
     * Re-checked both text tiers used on this ground against the
     * worst case (text directly over the densest part of the
     * silhouette):
     *   - full-opacity paper body text:        ~11.7:1
     *   - 0.75-opacity paper (secondary/meta):   ~7.4:1
     * Both still clear the 4.5:1 AA floor with wide margin. Don't push
     * past ~0.25 without re-checking the dimmed-text case specifically —
     * it's the tighter of the two.
     */
    opacity: 0.2;
  }

  /* About content. Text colour is inherited from .scroll-vessel-area's
     `color: paper`. Not using .prose here — it's built for a single
     vertical reading column (the article-page use case), and this is a
     two-column editorial grid instead: each statement heading pairs with
     its own paragraph, heading left / paragraph right, repeated per pair,
     rather than one long flow. */
  .about-content {
    position: relative;
    z-index: 1;
    padding-block: 4rem;
  }

  .about-grid {
    margin-top: 2.5rem;
  }

  .about-pair {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .about-pair + .about-pair {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
  }

  .about-pair h3 {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .about-pair p {
    font-family: var(--font-serif);
    font-size: var(--text-article);
    line-height: var(--leading-relaxed);
    max-width: 62ch;
  }

  .about-pair a {
    color: var(--color-gold);
  }

  /* Below this, the heading no longer needs to be narrower than its
     paragraph — stack them, heading above paragraph. */
  @media (max-width: 900px) {
    .about-pair {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* Divisions — stacking cards, pure CSS, no JavaScript at all. Cards sit
     in normal document flow; each one is position: sticky at its own
     increasing top offset, so as you scroll, the next card slides up and
     covers the previous one, leaving a sliver of it showing above. This
     replaces an earlier JS-driven pinned sequence (rAF loop, damped
     progress maths, a 300vh section, a pip indicator, a focusin handler
     to keep a faded block visible) — all removed, not just disabled. The
     case for CSS-only over that: no rAF loop to pause/resume, no
     reduced-motion special case to write (nothing here animates —
     elements simply stop where the browser is told to stick them, so
     there's nothing motion-sensitive to opt out of), no accessibility
     work needed (every card is always in normal flow, always fully
     visible, always tabbable — there was never an invisible or
     faded-out state to design around), and it degrades gracefully by
     construction anywhere position: sticky isn't supported: an
     unsupported browser just renders position: static, i.e. a plain
     stacked card list, no special fallback CSS required. Do not
     reintroduce a JS implementation of this section.

     No longer inside .scroll-vessel-area (see that comment above) — the
     ship's travel now ends at the bottom of About, so this section gets
     its own explicit navy-deep background/paper text instead of
     inheriting the vessel wrapper's.

     Verified, not assumed, against the actual background each element
     now sits on: cards have a SOLID navy-mid background (required for
     the stacking illusion — a transparent card wouldn't occlude the one
     sliding up behind it), so their contents are checked against
     navy-mid (#111834), not navy-deep or any ship blend (there's no ship
     behind this section any more). Gold text (number/tagline/link) vs
     navy-mid: ~11.1:1. Paper description at 0.78 opacity vs navy-mid:
     ~9.9:1. Gold border at 0.5 opacity (non-text, held to the 3:1
     guideline since it's what visually separates one card from the next,
     not decoration) vs navy-mid: ~3.7:1. The section heading sits
     directly on navy-deep (it's outside the cards): paper at 0.7 opacity
     vs navy-deep, ~8.8:1 — carried over unchanged from the previous
     version, now with even more margin since there's no ship-blended
     worst case to check against here any more. */
  .divisions-section {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    padding-block: 4rem 8rem;
  }

  .divisions-heading {
    font-size: var(--text-2xl);
    color: var(--color-paper);
    opacity: 0.7;
  }

  .divisions-stack {
    margin-top: 2.5rem;
    /* Matches the site header's own rendered height (measured: see
       CLAUDE.md's "Divisions" section for the figure) plus a little
       breathing room, so a card's sticky top edge can never end up
       under the header — true today even though the header isn't
       actually position: sticky itself, and keeps this correct without
       adjustment if that ever changes. */
    --header-clearance: 96px;
  }

  .division-card {
    position: sticky;
    /* Each card sticks 12px lower than the one before it, so the stack
       reads as a cascade rather than everything piling up at one exact
       offset — --i is set inline per card (0-indexed) in the markup. */
    top: calc(var(--header-clearance) + var(--i) * 12px);
    /* Later cards need to paint over earlier ones as they slide up.
       Sibling sticky elements with no z-index already paint in DOM
       order (later on top) per spec, but this is cheap to make explicit
       rather than lean on that default. */
    z-index: calc(var(--i) + 1);
    margin-inline: auto;
    width: 100%;
    max-width: 520px;
    padding: 2.5rem;
    /* Solid, not transparent — this is what makes the stacking effect
       read at all. A transparent card would let the one sliding up
       behind it show straight through instead of being covered. */
    background: var(--color-navy-mid);
    border: 1px solid color-mix(in srgb, var(--color-gold) 50%, transparent);
    border-radius: 8px;
    /* Soft upward shadow so the stacking edge reads as an edge, not just
       a flat colour change where one card's top overlaps the next. */
    box-shadow: 0 -16px 32px -16px rgb(0 0 0 / 0.5);
  }

  .division-card:not(:last-child) {
    margin-bottom: 80px;
  }

  .block-number {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-gold);
  }

  .division-card h3 {
    margin-top: 0.5rem;
    font-size: var(--text-xl);
  }

  .division-card .tagline {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
