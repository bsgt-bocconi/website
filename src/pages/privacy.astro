---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Data controller: whether this is BSGT or Università Bocconi is an
 * open item pending confirmation with CASA / Bocconi's data protection
 * office (spec §10). Defaulted to BSGT below since this is BSGT's own
 * site/domain/repo — update this section once that's confirmed.
 */
---

<BaseLayout
  title="Privacy Policy — BSGT"
  description="How BSGT — the Bocconi Shipping and Global Trade Student Association — handles data on this site."
>
  <article class="wrap privacy">
    <header class="page-header">
      <h1>Privacy Policy</h1>
      <p class="updated">Last updated 8 September 2026.</p>
    </header>

    <div class="prose">
      <p>
        This policy covers visitors to <strong>bocconishippingandglobaltrade.com</strong>, run by
        BSGT — the Bocconi Shipping and Global Trade Student Association, a recognised student
        association at Università Bocconi.
      </p>

      <h2>Data controller</h2>
      <p>
        BSGT (the Bocconi Shipping and Global Trade Student Association) is the data controller
        for this site.
      </p>

      <h2>Analytics</h2>
      <p>
        This site uses <strong>Cloudflare Web Analytics</strong> to understand roughly how many
        people visit and which pages they read. It does not use cookies, does not track visitors
        across other sites, and does not build an individual profile of you. Because it doesn't
        set cookies or track you before you've made a choice, this site doesn't need a cookie
        consent banner.
      </p>
      <p>
        We do not use Google Analytics, any advertising or tracking pixels, or any tag manager.
      </p>

      <h2>Cookies</h2>
      <p>
        This site does not set cookies for tracking, advertising, or analytics purposes.
      </p>

      <h2>Embedded content</h2>
      <p>
        We don't embed third-party content — such as Instagram or YouTube posts — that would set
        cookies before you've chosen to interact with it. Where we reference our social media, we
        link out to it instead.
      </p>

      <h2>Fonts</h2>
      <p>
        The fonts on this site are hosted on our own server, not loaded from a third-party font
        provider, so visiting this site doesn't send your IP address to an external font service.
      </p>

      <h2>Your rights</h2>
      <p>
        Under the EU General Data Protection Regulation, you have the right to access, correct, or
        request deletion of any personal data we hold about you, and to object to how it's
        processed. To exercise any of these rights, contact us using the details below.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy or your data can be sent to
        <a href="mailto:as.bsgt@studbocconi.it">as.bsgt@studbocconi.it</a>.
      </p>
      <p class="placeholder-note">
        Placeholder contact — confirm this is the address BSGT wants published here before launch.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .privacy {
    padding-block: 3rem 4rem;
  }

  .page-header {
    max-width: var(--measure);
    margin-bottom: 2rem;
  }

  .updated {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-slate);
  }

  .placeholder-note {
    margin-top: 0.5rem !important;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-slate);
  }
</style>
