---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventItem from '../components/EventItem.astro';

const events = await getCollection('events', ({ data }) => import.meta.env.DEV || data.draft === false);

const todayStart = new Date();
todayStart.setHours(0, 0, 0, 0);

const upcoming = events
  .filter((e) => e.data.date.valueOf() >= todayStart.valueOf())
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = events
  .filter((e) => e.data.date.valueOf() < todayStart.valueOf())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Events — BSGT"
  description="Upcoming and past guest lectures, workshops, and socials from BSGT."
>
  <div class="events-page on-dark">
    <div class="wrap-wide">
      <header class="page-header">
        <h1>Events</h1>
      </header>

      <section class="event-section">
        <h2>Upcoming</h2>
        {
          upcoming.length === 0 ? (
            <p class="empty">No upcoming events right now — check back soon.</p>
          ) : (
            <ul class="event-list">
              {upcoming.map((entry) => (
                <li>
                  <EventItem entry={entry} />
                </li>
              ))}
            </ul>
          )
        }
      </section>

      {
        past.length > 0 && (
          <section class="event-section">
            <h2>Past</h2>
            <ul class="event-list">
              {past.map((entry) => (
                <li>
                  <EventItem entry={entry} />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* Dark ground, same reasoning as team.astro — see CLAUDE.md. */
  .events-page {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    padding-block: 3rem 4rem;
  }

  .page-header {
    /* No measure cap — see team.astro's page-header for the same fix and
       reasoning: a short heading isn't a reading column. */
  }

  .event-section {
    /* No measure cap on the section/list itself either — each
       EventItem's own .description keeps its max-width: var(--measure)
       for the actual reading text, so removing the cap here just lets
       the surrounding list/dividers use the wrap-wide width instead of
       floating as a narrow strip. */
    margin-top: 3rem;
  }

  .event-section h2 {
    font-size: var(--text-2xl);
  }

  .event-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .event-list li + li {
    padding-top: 2rem;
    /* Not slate — a slate-based divider reads as barely-there against
       navy-deep (both are dark). Paper at low opacity is the site's
       established dark-ground divider convention (see Footer.astro). */
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
  }

  .empty {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-paper);
    opacity: 0.75;
  }
</style>
