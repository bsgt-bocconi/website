---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TagList from '../../components/TagList.astro';

const articles = (
  await getCollection('articles', ({ data }) => import.meta.env.DEV || data.draft === false)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(articles.flatMap((a) => a.data.tags))].sort();
---

<BaseLayout
  title="Articles — BSGT"
  description="Student-authored analysis and reporting on shipping, maritime economics, and global trade from BSGT."
>
  <div class="wrap articles-page">
    <header class="page-header">
      <h1>Articles</h1>
      <p class="dek">
        Student-authored analysis and reporting on shipping, maritime economics, and global trade.
      </p>
    </header>

    {allTags.length > 0 && <TagList tags={allTags} />}

    {
      articles.length === 0 ? (
        <p class="empty">No articles have been published yet — check back soon.</p>
      ) : (
        <ul class="article-list">
          {articles.map((entry) => (
            <li>
              <ArticleCard entry={entry} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .articles-page {
    padding-block: 3rem 4rem;
  }

  .page-header {
    max-width: var(--measure);
    margin-bottom: 2rem;
  }

  .dek {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-slate);
  }

  .articles-page > :global(.tag-list) {
    margin-bottom: 2.5rem;
  }

  .article-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-list li + li {
    padding-top: 2.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-slate) 25%, transparent);
  }

  .empty {
    padding-block: 2rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-slate);
    border-top: 1px solid color-mix(in srgb, var(--color-slate) 25%, transparent);
  }
</style>
