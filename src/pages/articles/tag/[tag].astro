---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import TagList from '../../../components/TagList.astro';
import { slugifyTag } from '../../../lib/format';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => import.meta.env.DEV || data.draft === false);
  const bySlug = new Map<string, string>();
  for (const entry of articles) {
    for (const tag of entry.data.tags) {
      const slug = slugifyTag(tag);
      if (!bySlug.has(slug)) bySlug.set(slug, tag);
    }
  }
  return Array.from(bySlug.entries()).map(([slug, label]) => ({
    params: { tag: slug },
    props: { label },
  }));
}

interface Props {
  label: string;
}

const { label } = Astro.props;

const allArticles = (
  await getCollection('articles', ({ data }) => import.meta.env.DEV || data.draft === false)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const articles = allArticles.filter((a) => a.data.tags.includes(label));
const allTags = [...new Set(allArticles.flatMap((a) => a.data.tags))].sort();
---

<BaseLayout
  title={`Articles tagged “${label}” — BSGT`}
  description={`Student-authored BSGT articles tagged “${label}”.`}
>
  <div class="wrap articles-page">
    <p class="back"><a href="/articles">All articles</a></p>
    <header class="page-header">
      <h1>Tagged: {label}</h1>
    </header>

    <TagList tags={allTags} activeTag={label} />

    <ul class="article-list">
      {
        articles.map((entry) => (
          <li>
            <ArticleCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .articles-page {
    padding-block: 3rem 4rem;
  }

  .back {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .back a {
    color: var(--color-slate);
  }

  .page-header {
    max-width: var(--measure);
    margin: 0.75rem 0 2rem;
  }

  .articles-page > :global(.tag-list) {
    margin-bottom: 2.5rem;
  }

  .article-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-list li + li {
    padding-top: 2.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-slate) 25%, transparent);
  }
</style>
