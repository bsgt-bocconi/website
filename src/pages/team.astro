---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';

// The schema still has `group` (board | departments | directors) — kept
// deliberately, not removed, so re-introducing the three-tier layout
// later is a template change here, not a content-schema migration. This
// page just doesn't render on it right now: everyone sits in one flat
// section. GROUP_RANK is only used to keep the overall sequence stable
// (board, then departments, then directors) while flattening — `order`
// alone can't do that on its own, since it's scoped within a group, not
// global (two people in different groups can share the same order).
const GROUP_RANK = { board: 0, departments: 1, directors: 2 } as const;

const members = (
  await getCollection('team', ({ data }) => import.meta.env.DEV || data.draft === false)
).sort((a, b) => {
  const rankDiff = GROUP_RANK[a.data.group] - GROUP_RANK[b.data.group];
  return rankDiff !== 0 ? rankDiff : a.data.order - b.data.order;
});
---

<BaseLayout
  title="Team — BSGT"
  description="The committee of the Bocconi Shipping and Global Trade Student Association."
>
  <div class="team-page on-dark">
    <div class="wrap-wide">
      <header class="page-header">
        <h1>The Team</h1>
        <p class="dek">The committee behind BSGT.</p>
      </header>

      {
        members.length === 0 ? (
          <p class="empty">The committee roster hasn't been published yet.</p>
        ) : (
          <ul class="team-grid">
            {members.map((member) => (
              <li>
                <TeamMemberCard member={member} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* Dark ground to match the rest of the association-facing site (see
     CLAUDE.md: dark = the association, light = where you read — articles
     stay on paper, this doesn't). Text colour set once here and inherited
     by everything below, including TeamMemberCard's markup. */
  .team-page {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    /* Bottom tightened from the sitewide 4rem — see CLAUDE.md's "Team
       page" section for why this page specifically needed less. */
    padding-block: 3rem 2rem;
  }

  .page-header {
    /* No measure cap — "The Team" plus one short line isn't a reading
       column, and capping it at 68ch left it floating narrow above a
       wide grid. Let it use the same wrap-wide width as the grid below. */
    margin-bottom: 3rem;
  }

  .dek {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    /* Not slate — fails AA on navy-deep at body size. See Carousel.astro's
       .empty for the same fix and the reasoning. */
    color: var(--color-paper);
    opacity: 0.75;
  }

  /* One flat grid, four across — 11 people doesn't divide evenly (4/4/3),
     and that's fine: a short final row is left where the grid naturally
     places it, not stretched or centred to disguise the count. Order
     still carries meaning even with no section headings any more —
     President/VPs, then department heads, then directors/leads, reading
     top-to-bottom, left-to-right — so this is a plain source-order grid,
     not anything that reorders visually. */
  .team-grid {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem 2.5rem;
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  .empty {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-paper);
    opacity: 0.75;
  }
</style>
