---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';

const allMembers = await getCollection(
  'team',
  ({ data }) => import.meta.env.DEV || data.draft === false,
);

// Order here is the page order top to bottom — board, then departments,
// then the remaining directors/leads — not alphabetical or anything
// derived from the data itself.
const GROUPS = [
  { key: 'board', heading: 'BSGT Board' },
  { key: 'departments', heading: 'Main Departments' },
  { key: 'directors', heading: 'Board Directors & Leads' },
] as const;

const sections = GROUPS.map((group) => ({
  ...group,
  members: allMembers
    .filter((member) => member.data.group === group.key)
    .sort((a, b) => a.data.order - b.data.order),
}));

const hasAnyMembers = allMembers.length > 0;
---

<BaseLayout
  title="Team — BSGT"
  description="The committee of the Bocconi Shipping and Global Trade Student Association."
>
  <div class="team-page on-dark">
    <div class="wrap-wide">
      <header class="page-header">
        <h1>The Team</h1>
        <p class="dek">The committee behind BSGT's lectures, workshops, research, and events.</p>
      </header>

      {
        !hasAnyMembers ? (
          <p class="empty">The committee roster hasn't been published yet.</p>
        ) : (
          sections.map(
            (section) =>
              section.members.length > 0 && (
                <section class={`team-section team-section--${section.key}`}>
                  <h2>{section.heading}</h2>
                  <ul class="team-grid">
                    {section.members.map((member) => (
                      <li>
                        <TeamMemberCard member={member} />
                      </li>
                    ))}
                  </ul>
                </section>
              ),
          )
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* Dark ground to match the rest of the association-facing site (see
     CLAUDE.md: dark = the association, light = where you read — articles
     stay on paper, this doesn't). Text colour set once here and inherited
     by everything below, including TeamMemberCard's markup. */
  .team-page {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    /* Bottom was 4rem, matching the other dark pages' shared convention
       — but this page's cards each carry their own tall, airy 4:5
       placeholder box, so the same 4rem read as noticeably more space
       than it does on a denser page like /events. Tightened here
       specifically, not sitewide. */
    padding-block: 3rem 2rem;
  }

  .page-header {
    /* No measure cap — "The Team" plus one short line isn't a reading
       column, and capping it at 68ch left it floating narrow above a
       wide grid. Let it use the same wrap-wide width as the grid below. */
    margin-bottom: 3rem;
  }

  .dek {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    /* Not slate — fails AA on navy-deep at body size. See Carousel.astro's
       .empty for the same fix and the reasoning. */
    color: var(--color-paper);
    opacity: 0.75;
  }

  .team-section + .team-section {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 15%, transparent);
  }

  .team-section h2 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    /* Same "quiet section heading" treatment used elsewhere on dark
       grounds (e.g. the homepage's .divisions-heading) — distinguishes
       the three tiers clearly without competing with "The Team" above
       them. Verified: paper @0.7 vs navy-deep is ~8.83:1, well past AA. */
    color: var(--color-paper);
    opacity: 0.7;
  }

  .team-grid {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2rem 2.5rem;
  }

  /* Explicit, group-specific column counts rather than one shared
     auto-fill grid — chosen so each breakpoint's column count divides
     the group's actual member count evenly (3 for board; 4, 2, or 1 for
     the two 4-person groups), so nothing ever wraps to a lone orphan
     card on its own row. auto-fill/auto-fit can't guarantee that for a
     fixed, known item count — it fits as many columns as the container
     allows, independent of how many items there are to fill them. */
  .team-section--board .team-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .team-section--departments .team-grid,
  .team-section--directors .team-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 900px) {
    .team-section--departments .team-grid,
    .team-section--directors .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .team-section--board .team-grid,
    .team-section--departments .team-grid,
    .team-section--directors .team-grid {
      grid-template-columns: 1fr;
    }
  }

  .empty {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-paper);
    opacity: 0.75;
  }
</style>
