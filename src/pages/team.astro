---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';

const members = (
  await getCollection('team', ({ data }) => import.meta.env.DEV || data.draft === false)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Team — BSGT"
  description="The committee of the Bocconi Shipping and Global Trade Student Association."
>
  <div class="team-page on-dark">
    <div class="wrap-wide">
      <header class="page-header">
        <h1>The Team</h1>
        <p class="dek">The committee behind BSGT's lectures, workshops, articles, and events.</p>
      </header>

      {
        members.length === 0 ? (
          <p class="empty">The committee roster hasn't been published yet.</p>
        ) : (
          <ul class="team-grid">
            {members.map((member) => (
              <li>
                <TeamMemberCard member={member} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* Dark ground to match the rest of the association-facing site (see
     CLAUDE.md: dark = the association, light = where you read — articles
     stay on paper, this doesn't). Text colour set once here and inherited
     by everything below, including TeamMemberCard's markup. */
  .team-page {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    padding-block: 3rem 4rem;
  }

  .page-header {
    /* No measure cap — "The Team" plus one short line isn't a reading
       column, and capping it at 68ch left it floating narrow above a
       wide grid. Let it use the same wrap-wide width as the grid below. */
    margin-bottom: 2.5rem;
  }

  .dek {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    /* Not slate — fails AA on navy-deep at body size. See Carousel.astro's
       .empty for the same fix and the reasoning. */
    color: var(--color-paper);
    opacity: 0.75;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 2rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    /* No cap here either — auto-fill naturally adds more columns as the
       wrap-wide container gets wider, which is the right way to use the
       extra space (more cards per row, not one stretched narrow strip). */
  }

  .empty {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-paper);
    opacity: 0.75;
  }
</style>
