---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';

// Group photo: picked up automatically if the file exists — drop it in at
// src/assets/team/group-photo.jpg (or .jpeg/.png/.webp) and the placeholder
// below is replaced on the next build, no template change needed. Globbed
// rather than imported directly because a static import of a missing file
// fails the build.
const groupPhoto = Object.values(
  import.meta.glob<ImageMetadata>('../assets/team/group-photo.{jpg,jpeg,png,webp}', {
    eager: true,
    import: 'default',
  }),
)[0];

// The schema still has `group` (board | departments | directors) — kept
// deliberately, not removed, so re-introducing the three-tier layout
// later is a template change here, not a content-schema migration. This
// page just doesn't render on it right now: everyone sits in one flat
// section. GROUP_RANK is only used to keep the overall sequence stable
// (board, then departments, then directors) while flattening — `order`
// alone can't do that on its own, since it's scoped within a group, not
// global (two people in different groups can share the same order).
const GROUP_RANK = { board: 0, departments: 1, directors: 2 } as const;

const members = (
  await getCollection('team', ({ data }) => import.meta.env.DEV || data.draft === false)
).sort((a, b) => {
  const rankDiff = GROUP_RANK[a.data.group] - GROUP_RANK[b.data.group];
  return rankDiff !== 0 ? rankDiff : a.data.order - b.data.order;
});
---

<BaseLayout
  title="Team — BSGT"
  description="The committee of the Bocconi Shipping and Global Trade Student Association."
>
  <div class="team-page on-dark">
    <div class="wrap-wide">
      <header class="page-header">
        <h1>The Team</h1>
        <p class="dek">The committee behind BSGT.</p>
      </header>

      {
        groupPhoto ? (
          <div class="group-photo">
            <Image
              src={groupPhoto}
              alt="Members of the BSGT committee standing together on the Bocconi campus"
              width={groupPhoto.width}
              height={groupPhoto.height}
              widths={[...[640, 960].filter((w) => w < groupPhoto.width), groupPhoto.width]}
              sizes="calc(min(100vw, 75rem) - 3rem)"
              loading="eager"
            />
          </div>
        ) : (
          // Same idea as TeamMemberCard's initials: a deliberate framed
          // panel with a short label, not an empty box. aria-hidden — it
          // carries no information a screen reader needs.
          <div class="group-photo group-photo--placeholder" aria-hidden="true">
            <span class="group-label">The BSGT Committee</span>
          </div>
        )
      }

      {
        members.length === 0 ? (
          <p class="empty">The committee roster hasn't been published yet.</p>
        ) : (
          <ul class="team-grid">
            {members.map((member) => (
              <li>
                <TeamMemberCard member={member} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* Dark ground to match the rest of the association-facing site (see
     CLAUDE.md: dark = the association, light = where you read — articles
     stay on paper, this doesn't). Text colour set once here and inherited
     by everything below, including TeamMemberCard's markup. */
  .team-page {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    /* Bottom tightened from the sitewide 4rem — see CLAUDE.md's "Team
       page" section for why this page specifically needed less. */
    padding-block: 3rem 2rem;
  }

  .page-header {
    /* No measure cap — "The Team" plus one short line isn't a reading
       column, and capping it at 68ch left it floating narrow above a
       wide grid. Let it use the same wrap-wide width as the grid below. */
    margin-bottom: 3rem;
  }

  /* Full wrap-wide width at 16:9. Same frame as the member cards — navy-mid
     fill, half-opacity gold border — in both states, so the photo arriving
     later drops into an identical box. */
  .group-photo {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-navy-mid);
    border: 1px solid color-mix(in srgb, var(--color-gold) 50%, transparent);
  }

  .group-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .group-photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .group-label {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: 0.03em;
    /* gold on navy-mid, ~11.1:1 — same pairing as the initials. */
    color: var(--color-gold);
  }

  .dek {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    /* Not slate — fails AA on navy-deep at body size. See Carousel.astro's
       .empty for the same fix and the reasoning. */
    color: var(--color-paper);
    opacity: 0.75;
  }

  /* One flat grid, four across — 11 people doesn't divide evenly (4/4/3),
     and that's fine: a short final row is left where the grid naturally
     places it, not stretched or centred to disguise the count. Order
     still carries meaning even with no section headings any more —
     President/VPs, then department heads, then directors/leads, reading
     top-to-bottom, left-to-right — so this is a plain source-order grid,
     not anything that reorders visually. */
  .team-grid {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem 2.5rem;
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  .empty {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-paper);
    opacity: 0.75;
  }
</style>
